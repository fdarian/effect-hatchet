{
	"name": "effect-hatchet",
	"version": "1.1.0",
	"description": "Effect-native bindings for Hatchet, with an in-memory implementation for tests.",
	"license": "Apache-2.0",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"repository": {
		"type": "git",
		"url": "https://github.com/fdarian/effect-hatchet.git"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"test:real": "HATCHET_TEST_REAL=1 vitest run tests/hatchet.real.test.ts",
		"ci:version": "changeset version",
		"ci:release": "pnpm run build && bun scripts/prepare-package-json.ts && changeset publish",
		"check:type": "tsc --noEmit",
		"check:lint": "biome check"
	},
	"peerDependencies": {
		"@hatchet-dev/typescript-sdk": "^1.0.0",
		"effect": "^4.0.0-rc.111"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@changesets/cli": "^2.31.0",
		"@effect/vitest": "4.0.0-rc.111",
		"@hatchet-dev/typescript-sdk": "^1.22.3",
		"@testcontainers/postgresql": "^12.1.0",
		"@types/bun": "latest",
		"@types/node": "^26.2.0",
		"effect": "4.0.0-rc.111",
		"testcontainers": "^12.1.0",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vitest": "^4.1.6"
	},
	"packageManager": "pnpm@12.0.0-rc.8",
	"devEngines": {
		"runtime": {
			"name": "bun",
			"version": "latest",
			"onFail": "download"
		}
	}
}
